# OpenWebUI Docker Environment Variables

# Connect to OpenClaw Gateway
OPENAI_API_BASE_URL=http://host.docker.internal:18789/v1
ENABLE_OPENAI_API=true

# Security
WEBUI_SECRET_KEY=change-me-in-production-with-strong-key

# API Keys (will be loaded from ~/.openclaw/api-keys.env)
OPENAI_API_KEY=sk-default
